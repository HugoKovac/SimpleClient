{
  "name": "simpleclient",
  "productName": "SimpleClient",
  "version": "0.1.0",
  "description": "Client de base de données épuré — PostgreSQL, MySQL, SQLite, ⌘K.",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "dist": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "mysql2": "3.11.5",
    "pg": "8.13.1",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "fr.projet-iota.simpleclient",
    "productName": "SimpleClient",
    "files": [
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "author": "Hugo Kovac",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoKovac/SimpleClient.git"
  }
}
